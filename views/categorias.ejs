<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('./partials/head', { titulo: 'Categorías' }) %>
</head>
<body class="min-h-screen flex flex-col">
  <%- include('./partials/navbar') %>

  <main class="flex-grow max-w-4xl mx-auto p-4 sm:p-6 lg:p-8 w-full">
    <h2 class="text-4xl font-bold text-primary mb-8 text-center">Categorías</h2>

    <div class="bg-white p-8 rounded-xl shadow-2xl border border-primary/10 mb-10">
      <h3 id="titulo-form" class="text-2xl font-semibold text-primary mb-4">Nueva categoría</h3>
      <form id="crear-categoria-form" novalidate>
        <div class="mb-5">
          <label for="nombre" class="block text-primary text-sm font-medium mb-2">
            Nombre de la categoría <span class="text-red-500">*</span>
          </label>
          <input type="text" id="nombre" name="nombre" required maxlength="50"
            class="w-full px-4 py-2 border border-primary/30 rounded-lg focus:ring-accent focus:border-accent transition duration-150 bg-secondary/50"
            placeholder="Ej: Pizzas">
        </div>
        <div class="flex gap-3">
          <button type="submit" id="btn-guardar"
            class="flex-1 bg-primary text-secondary py-3 rounded-lg font-semibold text-lg hover:bg-primary/90 transition duration-300 shadow-xl shadow-primary/20">
            Guardar categoría
          </button>
          <button type="button" id="btn-cancelar" class="hidden px-5 py-3 rounded-lg font-semibold text-primary border border-primary/30 hover:bg-primary/5 transition duration-300">
            Cancelar edición
          </button>
        </div>
      </form>
    </div>

    <h3 class="text-2xl font-semibold text-primary mb-4">Categorías registradas</h3>
    <% if (categorias.length === 0) { %>
      <div class="text-center py-10 bg-card-bg border border-primary/20 rounded-xl shadow-md">
        <p class="text-lg text-primary/80 font-semibold">Aún no hay categorías. Crea la primera con el formulario.</p>
      </div>
    <% } else { %>
      <ul class="flex flex-col gap-3" id="lista-categorias">
        <% categorias.forEach(categoria => { %>
          <li class="bg-card-bg border border-primary/10 rounded-xl p-4 flex flex-wrap items-center justify-between gap-3">
            <span class="text-lg font-semibold text-primary"><%= categoria.nombre %></span>
            <div class="flex gap-2">
              <button type="button" data-accion="editar" data-id="<%= categoria._id %>" data-nombre="<%= categoria.nombre %>"
                class="bg-accent text-primary px-3 py-1.5 rounded-lg font-semibold hover:brightness-95 transition">Editar</button>
              <button type="button" data-accion="eliminar" data-id="<%= categoria._id %>"
                class="bg-red-700 text-white px-3 py-1.5 rounded-lg font-semibold hover:bg-red-800 transition">Eliminar</button>
            </div>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </main>

  <%- include('./partials/footer') %>
  <script src="/js/categorias.js" type="module"></script>
</body>
</html>
